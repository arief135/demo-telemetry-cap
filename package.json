{
  "name": "demo-telemetry-cap",
  "version": "1.0.0",
  "description": "Welcome to your new CAP project.",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "cds-serve"
  },
  "dependencies": {
    "@cap-js/telemetry": "^2.0.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-host-metrics": "^0.5.0",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^7.0.0"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "telemetry": {
        "kind": "to-otlp",
        "resource": {
          "attributes": {
            "deployment.environment.name": "local"
          }
        }
      }
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
